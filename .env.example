# Copia este archivo a ".env" y rellena los valores reales. NO subas .env a git.
# Database
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/ac_api_db
SQL_ECHO=False

# Seguridad (genera una clave con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Protección del login: intentos fallidos permitidos y ventana en segundos
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Air Conditioning API
VERSION=1.0.0

# CORS (lista JSON). En producción, especifica los orígenes reales.
CORS_ORIGINS=["*"]

# Server
HOST=127.0.0.1
PORT=8000
RELOAD=False
